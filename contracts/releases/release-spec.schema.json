{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mindclade.internal/workflow-release-spec.schema.json",
  "additionalProperties": false,
  "properties": {
    "change_class": {"const": "major"},
    "contract_major": {"const": 5},
    "publication": {
      "additionalProperties": false,
      "properties": {
        "draft_on_tag": {"const": true},
        "protected_environments": {
          "const": ["workflow-release-platform", "workflow-release-security"],
          "type": "array"
        },
        "required_approvals": {"const": 2}
      },
      "required": ["draft_on_tag", "protected_environments", "required_approvals"],
      "type": "object"
    },
    "qualification": {
      "additionalProperties": false,
      "properties": {
        "connected_exact_tag": {"const": true},
        "independent_linux_rebuilds": {"const": 2},
        "native_systems": {
          "const": ["aarch64-darwin", "aarch64-linux", "x86_64-linux"],
          "type": "array"
        }
      },
      "required": ["connected_exact_tag", "independent_linux_rebuilds", "native_systems"],
      "type": "object"
    },
    "release_surfaces": {
      "additionalProperties": false,
      "properties": {
        "release_tools": {
          "const": [
            "tools/validate-release-spec.py",
            "tools/verify_release_tag.py"
          ],
          "type": "array"
        },
        "policy_manifest": {
          "const": ["contracts/policy-bundle"],
          "type": "array"
        },
        "policy_tools": {
          "const": [
            "tools/enrich_spdx_license.py",
            "tools/policy_adoption.py",
            "tools/policy_bundle.py",
            "tools/third_party_notices.py",
            "tools/validate_pr_policy.py"
          ],
          "type": "array"
        },
        "repository_home_action": {
          "const": ["actions/validate-repository-home"],
          "type": "array"
        },
        "required_workflows": {
          "const": [
            ".github/workflows/required-repository-policy.yml",
            ".github/workflows/required-security-baseline.yml"
          ],
          "type": "array"
        },
        "reusable_workflows": {
          "items": {
            "pattern": "^\\.github/workflows/reusable-[a-z0-9-]+\\.yml$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "workflow_contracts": {
          "items": {
            "pattern": "^contracts/workflows/reusable-[a-z0-9-]+\\.json$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "reusable_workflows",
        "workflow_contracts",
        "required_workflows",
        "repository_home_action",
        "release_tools",
        "policy_tools",
        "policy_manifest"
      ],
      "type": "object"
    },
    "release_tag": {"const": "v5.0.0"},
    "schema_version": {"const": 2}
  },
  "required": [
    "schema_version",
    "release_tag",
    "contract_major",
    "change_class",
    "release_surfaces",
    "qualification",
    "publication"
  ],
  "type": "object"
}
