{
  "inputs": {
    "allowed-binary-extensions": {
      "default": "png jpg jpeg gif webp ico woff woff2 pdf",
      "type": "string"
    },
    "enforce": {
      "default": false,
      "type": "boolean"
    },
    "max-added-kb": {
      "default": 1024,
      "type": "number"
    },
    "max-binary-total-kb": {
      "default": 4096,
      "type": "number"
    },
    "max-file-kb": {
      "default": 512,
      "type": "number"
    }
  },
  "job_permissions": {},
  "jobs": [
    "hygiene"
  ],
  "outputs": [],
  "permissions": {
    "contents": "read"
  },
  "schema_version": 1,
  "secrets": {},
  "workflow": ".github/workflows/reusable-repo-hygiene.yml"
}
