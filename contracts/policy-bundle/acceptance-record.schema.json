{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.dev/contracts/policy-acceptance-record/v1",
  "title": "Mindclade policy-bundle acceptance record",
  "description": "Evidence contract for acceptance captured by an approved contract or identity system. Records containing personal data, signatures, or credentials must not be stored in a source repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "subject",
    "bundle",
    "acceptance",
    "retention"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "recordId": {
      "type": "string",
      "pattern": "^PAC-[A-Z0-9][A-Z0-9._-]{7,127}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reference", "agreementReference"],
      "properties": {
        "type": {
          "enum": ["employee", "contractor", "customer", "vendor", "other-authorized-party"]
        },
        "reference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{7,255}$",
          "description": "Opaque identity-system reference; never a name, email address, or raw identifier."
        },
        "agreementReference": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{7,255}$"
        }
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestSha256", "attestationReference"],
      "properties": {
        "id": {"const": "mindclade-policy-bundle"},
        "version": {"type": "string", "pattern": "^[0-9]{4}\.[0-9]{2}\.[0-9]{2}\.[1-9][0-9]*$"},
        "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "attestationReference": {"type": "string", "pattern": "^https://[^\\s]+$"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedAt", "method", "evidenceUri", "evidenceSha256", "capturedBy"],
      "properties": {
        "acceptedAt": {"type": "string", "format": "date-time"},
        "method": {
          "enum": ["signed-agreement", "authenticated-clickwrap", "employment-onboarding", "contractor-onboarding", "renewal"]
        },
        "evidenceUri": {"type": "string", "pattern": "^https://[^\\s]+$"},
        "evidenceSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "capturedBy": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{7,255}$"}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordClass", "retainUntil", "legalHold"],
      "properties": {
        "recordClass": {"const": "legal-policy-acceptance"},
        "retainUntil": {"type": "string", "format": "date"},
        "legalHold": {"type": "boolean"}
      }
    }
  }
}
