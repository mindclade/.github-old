{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.dev/contracts/policy-bundle/adoption-record/v1",
  "additionalProperties": false,
  "properties": {
    "bundleId": {"const": "mindclade-policy-bundle"},
    "bundleVersion": {"pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$", "type": "string"},
    "manifestSha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "releaseCommit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "releaseTag": {"const": "v5.0.0"},
    "schemaVersion": {"const": 1},
    "validatorSha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": [
    "schemaVersion",
    "bundleId",
    "bundleVersion",
    "releaseTag",
    "releaseCommit",
    "manifestSha256",
    "validatorSha256"
  ],
  "type": "object"
}
